{
  "id": "ai-blogger",
  "name": "AI Blogger Radar",
  "display_names": {
    "zh": "AI 博主选题雷达"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 12000,
    "enrichment_max_chars": 24000,
    "sampling": "head-middle-tail"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      {
        "id": "summary",
        "type": "section",
        "tools": [],
        "primary": true
      },
      {
        "id": "why_it_matters",
        "type": "section",
        "tools": [
          "web_search"
        ]
      },
      {
        "id": "content_angles",
        "type": "section",
        "tools": [],
        "optional": true
      },
      {
        "id": "community_discussion",
        "type": "section",
        "tools": [],
        "optional": true
      }
    ]
  }
}
